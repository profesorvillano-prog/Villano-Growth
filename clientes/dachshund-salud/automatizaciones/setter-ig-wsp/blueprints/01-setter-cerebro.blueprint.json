{
  "name": "[SETTER] Marcelo - IG+WSP -> Consulta",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": { "hook": 3583173, "maxResults": 1 },
      "mapper": {},
      "metadata": {
        "designer": { "x": 0, "y": 0, "name": "Mensaje entrante (GHL)" },
        "restore": { "parameters": { "hook": { "label": "SETTER Marcelo IG-WSP" } } }
      }
    },
    {
      "id": 2,
      "module": "datastore:GetRecord",
      "version": 1,
      "parameters": { "datastore": 168449 },
      "filter": {
        "name": "Solo entrantes con texto",
        "conditions": [
          [
            { "a": "{{1.direccion}}", "b": "inbound", "o": "text:equal" },
            { "a": "{{1.mensaje}}", "o": "exist" }
          ]
        ]
      },
      "mapper": { "key": "{{1.contactId}}" },
      "metadata": {
        "designer": { "x": 300, "y": 0, "name": "Estado del lead" },
        "restore": { "parameters": { "datastore": { "label": "setter_marcelo" } } }
      }
    },
    {
      "id": 3,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": { "handleErrors": true, "useNewZLibDeCompress": true },
      "filter": {
        "name": "No pausado por humano",
        "conditions": [
          [ { "a": "{{2.pausado}}", "b": "true", "o": "text:notequal" } ]
        ]
      },
      "mapper": {
        "url": "https://api.anthropic.com/v1/messages",
        "method": "post",
        "headers": [
          { "name": "x-api-key", "value": "PEGAR_ANTHROPIC_API_KEY" },
          { "name": "anthropic-version", "value": "2023-06-01" },
          { "name": "content-type", "value": "application/json" }
        ],
        "qs": [],
        "bodyType": "raw",
        "contentType": "application/json",
        "data": "{\"model\":\"claude-haiku-4-5-20251001\",\"max_tokens\":700,\"temperature\":0.6,\"system\":\"PEGAR_AQUI_EL_PROMPT_COMPLETO_DEL_DOC_03\",\"messages\":[{\"role\":\"user\",\"content\":\"ESTADO ACTUAL: {{2.estado}}\\nDATOS YA CAPTURADOS: {{2.datos}}\\nCANAL: {{1.canal}}\\nNOMBRE EN EL PERFIL: {{1.nombre}}\\nSEGUIMIENTOS ENVIADOS: {{2.fu_count}}\\n\\nHISTORIAL:\\n{{2.historial}}\\n\\nMENSAJE NUEVO DEL LEAD:\\n{{1.mensaje}}\"},{\"role\":\"assistant\",\"content\":\"{\"}]}",
        "parseResponse": true
      },
      "metadata": { "designer": { "x": 600, "y": 0, "name": "Cerebro (Anthropic)" } }
    },
    {
      "id": 4,
      "module": "json:ParseJSON",
      "version": 1,
      "parameters": { "type": 541591 },
      "mapper": { "json": "{{ \"{\" + 3.data.content[1].text }}" },
      "metadata": {
        "designer": { "x": 900, "y": 0, "name": "Leer decision de la IA" },
        "restore": { "parameters": { "type": { "label": "setter_respuesta_ia" } } }
      }
    },
    {
      "id": 5,
      "module": "builtin:BasicRouter",
      "version": 1,
      "mapper": null,
      "metadata": { "designer": { "x": 1200, "y": 0, "name": "Ruta segun accion" } },
      "routes": [
        {
          "flow": [
            {
              "id": 6,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": { "handleErrors": true, "useNewZLibDeCompress": true },
              "filter": {
                "name": "A · Ofrecer consulta",
                "conditions": [ [ { "a": "{{4.accion}}", "b": "ofrecer_consulta", "o": "text:equal" } ] ]
              },
              "mapper": {
                "url": "https://services.leadconnectorhq.com/conversations/messages",
                "method": "post",
                "headers": [
                  { "name": "Authorization", "value": "Bearer PEGAR_GHL_TOKEN" },
                  { "name": "Version", "value": "2021-04-15" },
                  { "name": "Content-Type", "value": "application/json" }
                ],
                "qs": [],
                "bodyType": "raw",
                "contentType": "application/json",
                "data": "{\"type\":\"{{1.canal}}\",\"contactId\":\"{{1.contactId}}\",\"message\":\"{{replace(4.respuesta; newline; \"\\n\")}}\\n\\nAca va el link para reservar tu Consulta de Evaluacion con Marcelo:\\n[LINK_PAGO]\\n\\nSon [PRECIO_CONSULTA] y dura entre 45 y 60 minutos por videollamada. Apenas se confirma el pago te llega el link para elegir dia y hora.\"}",
                "parseResponse": true
              },
              "metadata": { "designer": { "x": 1500, "y": -600, "name": "Enviar oferta + link de pago" } }
            },
            {
              "id": 7,
              "module": "datastore:AddRecord",
              "version": 1,
              "parameters": { "datastore": 168449 },
              "mapper": {
                "key": "{{1.contactId}}",
                "overwrite": true,
                "conversationId": "{{1.conversationId}}",
                "canal": "{{1.canal}}",
                "estado": "link_enviado",
                "temperatura": "{{4.temperatura}}",
                "datos": "{{toString(4.datos)}}",
                "historial": "{{substring(2.historial + newline + \"LEAD: \" + 1.mensaje + newline + \"BOT: \" + 4.respuesta; 0; 6000)}}",
                "fu_count": 0,
                "pausado": false,
                "ultimo_mensaje_at": "{{now}}"
              },
              "metadata": {
                "designer": { "x": 1800, "y": -600, "name": "Guardar estado" },
                "restore": { "parameters": { "datastore": { "label": "setter_marcelo" } } }
              }
            },
            {
              "id": 8,
              "module": "http:ActionSendData",
              "version": 3,
              "parameters": { "handleErrors": true, "useNewZLibDeCompress": true },
              "mapper": {
                "url": "https://services.leadconnectorhq.com/contacts/{{1.contactId}}",
                "method": "put",
                "headers": [
                  { "name": "Authorization", "value": "Bearer PEGAR_GHL_TOKEN" },
                  { "name": "Version", "value": "2021-07-28" },
                  { "name": "Content-Type", "value": "application/json" }
                ],
                "qs": [],
                "bodyType": "raw",
                "contentType": "application/json",
                "data": "{\"tags\":[\"setter-activo\",\"setter-calificado\",\"setter-consulta-ofrecida\"],\"customFields\":[{\"key\":\"setter_nombre_perro\",\"field_value\":\"{{4.datos.nombre_perro}}\"},{\"key\":\"setter_edad_perro\",\"field_value\":\"{{4.datos.edad_perro}}\"},{\"key\":\"setter_sintoma\",\"field_value\":\"{{4.datos.sintoma}}\"},{\"key\":\"setter_hace_cuanto\",\"field_value\":\"{{4.datos.hace_cuanto}}\"},{\"key\":\"setter_come_hoy\",\"field_value\":\"{{4.datos.come_hoy}}\"},{\"key\":\"setter_ya_intento\",\"field_value\":\"{{4.datos.ya_intento}}\"},{\"key\":\"setter_pais\",\"field_value\":\"{{4.datos.pais}}\"},{\"key\":\"setter_temperatura\",\"field_value\":\"{{4.temperatura}}\"},{\"key\":\"setter_estado\",\"field_value\":\"link_enviado\"}]}",
                "parseResponse": true
              },
              "metadata": { "designer": { "x": 2100, "y": -600, "name": "Actualizar contacto GHL" } }
            }
          ]
        },
        {
          "flow": [
