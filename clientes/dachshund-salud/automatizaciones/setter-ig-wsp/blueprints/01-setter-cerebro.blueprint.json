                "url": "PEGAR_WEBHOOK_AVISO_MARCELO",
                "method": "post",
                "headers": [ { "name": "Content-Type", "value": "application/json" } ],
                "qs": [],
                "bodyType": "raw",
                "contentType": "application/json",
                "data": "{\"tipo\":\"HANDOFF\",\"contactId\":\"{{1.contactId}}\",\"nombre\":\"{{4.datos.nombre_dueno}}\",\"perro\":\"{{4.datos.nombre_perro}}\",\"mensaje\":\"{{replace(1.mensaje; newline; \" \")}}\",\"nota\":\"{{replace(4.nota_para_marcelo; newline; \" \")}}\"}",
                "parseResponse": true
              },
              "metadata": { "designer": { "x": 1500, "y": 300, "name": "Avisar a Marcelo" } }
            },
